APP_NAME=Demera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://demera.my.id
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning or error
LOG_LEVEL=debug

# ── Database (MySQL 8) ───────────────────────────────────────────
DB_CONNECTION=mysql
# Docker: "mysql" (service name). Non-Docker: your DB host, e.g. 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=demera
DB_USERNAME=demera
DB_PASSWORD=
# Only used to bootstrap the mysql container in docker-compose.yml — not
# read by Laravel itself. Leave unset for non-Docker deployments.
DB_ROOT_PASSWORD=

# ── Session / Cache / Queue (Redis) ──────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (served over HTTPS): true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=demera_cache

REDIS_CLIENT=phpredis
# Docker: "redis" (service name). Non-Docker: your Redis host, e.g. 127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────
# Dev default "log" writes emails to storage/logs/laravel.log instead of
# sending them. Switch to "smtp" and fill in real credentials for staging/prod.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@demera.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage (S3-compatible: MinIO in dev, AWS S3 in prod) ────
# Credentials Laravel actually connects with.
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_REGION=us-east-1
# MinIO/self-hosted: internal endpoint the app container reaches, e.g.
# http://minio:9000. Real AWS S3: leave empty (uses AWS's regional endpoint).
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Public-facing endpoint used to rewrite presigned URLs so they're reachable
# from the user's browser (only needed when OBJECT_STORAGE_ENDPOINT is an
# internal/Docker-only hostname). Real AWS S3: leave empty.
OBJECT_STORAGE_ENDPOINT_PUBLIC_URL=http://localhost:9000
# MinIO requires path-style URLs (bucket in the path, not subdomain). AWS S3: false.
OBJECT_STORAGE_USE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET_PUBLIC=demera-public
OBJECT_STORAGE_BUCKET_PRIVATE=demera-private

# MinIO server bootstrap credentials (docker-compose.yml minio service only).
# In dev these are intentionally identical to OBJECT_STORAGE_KEY/SECRET above.
# Not used at all for real AWS S3 in production — remove.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_PUBLIC=demera-public
MINIO_BUCKET_PRIVATE=demera-private
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Docker Compose host port mappings ────────────────────────────
APP_PORT=80
DB_FORWARD_PORT=3306
VITE_PORT=5173

VITE_APP_NAME="${APP_NAME}"

# ── Super Admin seed account ─────────────────────────────────────
# Read once by database/seeders/SuperAdminSeeder.php. The account is forced
# to change its password on first login (must_change_password=true) — these
# values only need to be strong enough to survive until that first login.
# NEVER reuse this password anywhere else, and rotate SUPERADMIN_PASSWORD
# immediately after the first production seed.
SUPERADMIN_NAME="Demera Super Admin"
SUPERADMIN_EMAIL=superadmin@demera.my.id
SUPERADMIN_WHATSAPP=+6281200000000
SUPERADMIN_PASSWORD=

# ── WhatsApp notification provider ───────────────────────────────
# Abstraction layer (see docs/ARSITEKTUR.md) — Tahap 1 ships only the "log"
# driver (writes to the log instead of sending). Wire up a real provider
# (e.g. Fonnte, Woowa/WhatsApp Cloud API, Twilio) in Tahap 6.
WHATSAPP_PROVIDER=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_NUMBER=

# ── Payment gateway ───────────────────────────────────────────────
# Abstraction layer — Tahap 1 ships only "manual" (bank transfer, verified
# by finance staff). Wire up a real gateway in Tahap 4.
PAYMENT_GATEWAY_PROVIDER=manual
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_WEBHOOK_SIGNATURE_KEY=
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
